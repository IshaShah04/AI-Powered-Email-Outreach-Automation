    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst sheetRows = $('Get row(s) in sheet').all();\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const originalRow = sheetRows[i].json;\n\n  const rawText = item.json.content.parts[0].text;\n  const cleaned = rawText.replace(/```json|```/g, '').trim();\n\n  let parsed;\n  try {\n    parsed = JSON.parse(cleaned);\n  } catch (e) {\n    parsed = {\n      subject: '',\n      body: '',\n      confidence: 0,\n      parse_error: true\n    };\n  }\n\n  results.push({\n    json: {\n      ...originalRow,\n      subject: parsed.subject,\n      body: parsed.body,\n      confidence: parsed.confidence\n    }\n  });\n}\n\nreturn results;"
      },
